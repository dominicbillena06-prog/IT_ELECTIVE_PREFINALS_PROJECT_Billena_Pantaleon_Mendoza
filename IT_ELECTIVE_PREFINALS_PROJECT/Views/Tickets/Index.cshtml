@model IEnumerable<IT_ELECTIVE_PREFINALS_PROJECT.Models.Ticket>

    @{
    ViewData["Title"] = "Tickets";
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Help Desk Tickets</h2>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Subject</th>
                <th>Customer</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Created Date</th>
                <th>Due Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
        {
            <tr>
                <td><strong>#@item.Id</strong></td>
                <td>@item.Subject</td>
                <td>@item.Customer?.CompanyName</td>
                <td>@item.Category?.Name</td>
                <td>
                    <span class="badge bg-warning text-dark">@item.Priority?.Name</span>
                </td>
                <td>
                    <span class="badge bg-info text-dark">@item.Status?.Name</span>
                </td>
                <td>@item.CreatedAt</td>
                <td>@(string.IsNullOrEmpty(item.DueAt) ? "N/A" : item.DueAt)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                        View Details
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
